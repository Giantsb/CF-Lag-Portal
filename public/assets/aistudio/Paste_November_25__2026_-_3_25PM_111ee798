    .cap-name { font-size: 16px; font-weight: 500; color: var(--bl-navy-ink); letter-spacing: -0.01em; }
    .cap-desc { font-size: 13px; color: var(--bl-ink-3); max-width: 280px; text-align: center; line-height: 1.5; margin-top: -6px; }

    /* ===================================================== */
    /* Splash                                                 */
    /* ===================================================== */
    .splash {
      position: absolute; inset: 0; overflow: hidden;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      color: #fff;
      background:
        radial-gradient(120% 85% at 50% 30%, #3A1412 0%, transparent 58%),
        radial-gradient(120% 70% at 50% 118%, rgba(179,56,47,.30), transparent 55%),
        #0A0909;
    }
    .splash::before {
      content: ''; position: absolute; inset: 0;
      background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image: radial-gradient(80% 60% at 50% 42%, black, transparent 78%);
    }
    .glow {
      position: absolute; top: 40%; left: 50%; width: 330px; height: 330px;
      transform: translate(-50%, -50%);
      background: radial-gradient(circle, rgba(224,71,61,.26), rgba(224,71,61,.30) 30%, rgba(110,30,24,.25) 50%, transparent 68%);
      filter: blur(12px); opacity: 0;
      animation: glowIn 1.2s ease 2.1s forwards, breathe 3.6s ease-in-out 3.3s infinite;
    }
    @keyframes glowIn { to { opacity: .8; } }
    @keyframes breathe { 0%,100% { transform: translate(-50%,-50%) scale(.9); opacity: .65; } 50% { transform: translate(-50%,-50%) scale(1.12); opacity: .95; } }

    /* city lights */
    .spark { position: absolute; bottom: 30%; border-radius: 999px; background: #E0473D; opacity: 0; animation: rise linear infinite; box-shadow: 0 0 6px rgba(224,71,61,.7); }
    @keyframes rise { 0% { transform: translateY(30px) scale(.6); opacity: 0; } 15% { opacity: .8; } 85% { opacity: .35; } 100% { transform: translateY(-170px) scale(1.1); opacity: 0; } }
    .splash.light .spark { background: #B3382F; box-shadow: none; }

    .stack { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: center; margin-top: -40px; }

    /* the House of Athletes mark: the frame draws out from LAGOS, the sun comes up, the Lagos skyline rises block by block, then HOUSE OF, ATHLETES, GYM and LAGOS land */
    .ha-mark { display: block; overflow: visible; }
    .ha-mark .frame { stroke-dasharray: 1 2; stroke-dashoffset: 1; animation: draw 1.1s cubic-bezier(.55,0,.3,1) .15s forwards; }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    .ha-mark .sun { transform: translateY(26px); opacity: 0; animation: sun 1.2s cubic-bezier(.22,1,.36,1) .7s forwards; }
    @keyframes sun { 30% { opacity: .9; } to { opacity: .55; transform: none; } }
    .ha-mark .col { transform-box: fill-box; transform-origin: 50% 100%; transform: scaleY(0); animation: grow .5s cubic-bezier(.22,1,.36,1) forwards; }
    @keyframes grow { to { transform: scaleY(1); } }
    .ha-mark .up { opacity: 0; transform: translateY(6px); animation: up .4s cubic-bezier(.22,1,.36,1) forwards; }
    @keyframes up { to { opacity: 1; transform: none; } }
    .ha-mark .slam { transform-box: fill-box; transform-origin: 50% 100%; opacity: 0; transform: translateY(-14px) scale(1.25); animation: slam .34s cubic-bezier(.4,1.3,.6,1) forwards; }
    @keyframes slam { to { opacity: 1; transform: none; } }
    .ha-mark .spread { opacity: 0; letter-spacing: 0; animation: up .5s ease 2.65s forwards; }
    .ha-mark .halo { filter: drop-shadow(0 0 12px rgba(224,71,61,.28)); }
    .splash.light .ha-mark .halo { filter: none; }

    .word {
      margin-top: 24px; font-size: 22px; font-weight: 600; letter-spacing: -0.03em; white-space: nowrap;
      opacity: 0; transform: translateY(10px);
      animation: fadeUp .7s ease 2.45s forwards;
    }
    .word b { color: var(--bl-green-bright); font-weight: 600; }
    .word .rest { font-weight: 500; }
    .tag {
      margin-top: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .2em; text-transform: uppercase;
      color: var(--bl-yellow); opacity: 0; transform: translateY(10px);
      animation: fadeUp .7s ease 2.7s forwards;
    }
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
    .load { margin-top: 28px; width: 120px; height: 3px; border-radius: 999px; background: rgba(255,255,255,.12); overflow: hidden; opacity: 0; animation: fadeUp .6s ease 3s forwards; }
    .load .fill { height: 100%; width: 40%; border-radius: 999px; background: var(--bl-yellow); box-shadow: 0 0 8px rgba(224,71,61,.8); animation: slide 1.5s ease-in-out 3.1s infinite; transform: translateX(-120%); }
    @keyframes slide { 0% { transform: translateX(-120%); } 100% { transform: translateX(320%); } }

    /* heartbeat horizon */
    .horizon { position: absolute; left: 0; right: 0; bottom: 84px; height: 30px; z-index: 2; opacity: 0; animation: fadeUp .8s ease 2.9s forwards; }
    .horizon path { fill: none; stroke: rgba(224,71,61,.6); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 5px rgba(224,71,61,.55)); }
    .horizon .beat { stroke: var(--bl-yellow); stroke-dasharray: 60 900; stroke-dashoffset: 60; animation: beat 2.6s ease-in-out 3.2s infinite; }
    @keyframes beat { 0% { stroke-dashoffset: 60; } 100% { stroke-dashoffset: -900; } }
    .foot-note { position: absolute; bottom: 44px; left: 0; right: 0; text-align: center; font-family: var(--font-mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: #999999; opacity: 0; animation: fadeUp .6s ease 3.2s forwards; }
    .foot-note b { color: #E2E2E2; font-weight: 600; }

    /* light splash: the logo exactly as printed */
    .splash.light {
      color: var(--bl-navy-ink);
      background:
        radial-gradient(120% 80% at 50% 26%, rgba(179,56,47,.10), transparent 58%),
        radial-gradient(120% 70% at 50% 120%, rgba(17,17,17,.10), transparent 52%),
        #FFFFFF;
    }
    .splash.light::before { background-image: radial-gradient(rgba(17,17,17,.07) 1px, transparent 1px); }
    .splash.light .glow { background: radial-gradient(circle, rgba(224,71,61,.22), rgba(179,56,47,.14) 32%, rgba(17,17,17,.05) 50%, transparent 68%); }
    .splash.light .bl-mark .b-img { filter: none; }
    .splash.light .bl-mark .leaves { filter: drop-shadow(0 2px 6px rgba(179,56,47,.25)); }
    .splash.light .word b { color: var(--bl-green); }
    .splash.light .tag { color: var(--bl-yellow-ink); }
    .splash.light .load { background: rgba(17,17,17,.1); }
    .splash.light .load .fill { background: var(--bl-yellow-deep); box-shadow: 0 0 8px rgba(179,56,47,.5); }
    .splash.light .horizon path { stroke: rgba(17,17,17,.22); filter: none; }
    .splash.light .horizon .beat { stroke: var(--bl-yellow-deep); }
    .splash.light .foot-note { color: var(--bl-ink-3); }
    .splash.light .foot-note b { color: var(--bl-navy-ink); }

    /* ===================================================== */
    /* App screens                                            */
    /* ===================================================== */
    .bl-app { display: block; background: var(--bl-bg); min-height: 100%; padding: 58px 0 0; color: var(--bl-navy-ink); position: relative; }
    .app-head { display: flex; align-items: center; gap: 12px; padding: 8px 20px 16px; }
    .app-head .who { flex: 1; }
    .app-head .h { font-size: 12.5px; color: var(--bl-ink-3); }
    .app-head .name { font-size: 21px; font-weight: 600; letter-spacing: -0.02em; }
    .app-head .logo-chip { width: 84px; height: 36px; border-radius: 11px; background: #fff; border: 1px solid var(--bl-line); display: flex; align-items: center; justify-content: center; }
    .app-head .logo-chip img { width: 74px; }
    .scr-title { padding: 6px 20px 14px; font-size: 26px; font-weight: 600; letter-spacing: -0.025em; }

    .mcard { margin: 0 20px; border-radius: 22px; padding: 20px; position: relative; overflow: hidden; color: #fff;
      background: linear-gradient(140deg, #3A1412 0%, #151515 45%, #0F0F0F 100%); box-shadow: 0 14px 30px rgba(17,17,17,.28); }
    .mcard .wm { position: absolute; right: -24px; bottom: -14px; width: 220px; opacity: .14; pointer-events: none; }
    .mcard .lv { position: absolute; right: 18px; bottom: 16px; width: 34px; opacity: .9; }
    .mcard .lbl { font-family: var(--font-mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: .1em; opacity: .7; }
    .mcard .val { font-size: 13.5px; font-weight: 500; margin-top: 2px; }
    .mcard .tier { position: absolute; top: 20px; right: 20px; background: var(--bl-yellow); color: #111111; padding: 4px 10px; border-radius: 999px; font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
    .mcard h3 { font-size: 22px; letter-spacing: -0.02em; margin: 20px 0 4px; font-weight: 600; line-height: 1.15; }
    .mcard .pulse { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; opacity: .9; }
    .pulse-dot { width: 6px; height: 6px; border-radius: 999px; background: var(--bl-green-bright); box-shadow: 0 0 0 4px rgba(224,71,61,.3); animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 50% { box-shadow: 0 0 0 8px rgba(224,71,61,.08); } }
    .mcard .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.12); position: relative; }

    .cta { margin: 16px 20px; background: var(--bl-green); color: #fff; border-radius: 16px; padding: 16px; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 15.5px; font-weight: 600; box-shadow: 0 10px 22px rgba(179,56,47,.32); width: calc(100% - 40px); }
    .quick { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 8px; padding: 0 20px; }
    .qt { aspect-ratio: 1/1; background: #fff; border-radius: 15px; border: 1px solid var(--bl-line); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; font-size: 9.5px; font-weight: 500; color: var(--bl-navy-ink); white-space: nowrap; }
    .qt .ib { width: 30px; height: 30px; border-radius: 9px; background: var(--bl-navy-soft); color: var(--bl-navy); display: flex; align-items: center; justify-content: center; }
    .sec { font-size: 10.5px; text-transform: uppercase; letter-spacing: .09em; color: var(--bl-ink-3); font-weight: 600; padding: 22px 20px 8px; display: flex; justify-content: space-between; }
    .sec .more { color: var(--bl-green-ink); font-weight: 600; letter-spacing: .04em; }
    .lcard { margin: 0 20px; background: #fff; border-radius: 14px; border: 1px solid var(--bl-line); overflow: hidden; }
    .lrow { display: flex; align-items: center; gap: 12px; padding: 13px 14px; border-bottom: 1px solid var(--bl-line); }
    .lrow:last-child { border-bottom: 0; }
    .lrow .iw { width: 34px; height: 34px; border-radius: 10px; background: var(--bl-navy-soft); color: var(--bl-navy); display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
    .lrow .iw.g { background: var(--bl-green-soft); color: var(--bl-green-ink); }
    .lrow .c { flex: 1; min-width: 0; }
    .lrow .t { font-size: 13.5px; font-weight: 500; }
    .lrow .m { font-size: 11.5px; color: var(--bl-ink-3); margin-top: 1px; }
    .lrow .r { font-family: var(--font-mono); font-size: 12px; text-align: right; }
    .chip { white-space: nowrap; display: inline-flex; align-items: center; height: 20px; padding: 0 8px; border-radius: 999px; font-size: 10px; font-weight: 600; letter-spacing: .03em; }
    .chip.g { background: var(--bl-green-soft); color: var(--bl-green-ink); }
    .chip.n { background: var(--bl-navy-soft); color: var(--bl-navy); }
    .chip.y { background: var(--bl-yellow-soft); color: var(--bl-yellow-ink); }

    .tabbar { position: sticky; bottom: 0; margin-top: 22px; height: 82px; z-index: 30; display: flex; padding: 9px 16px 24px; background: rgba(255,255,255,.92); backdrop-filter: blur(16px) saturate(180%); border-top: .5px solid var(--bl-line); }
    .tabbar .ti { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; color: #737373; font-size: 10px; font-weight: 500; position: relative; }
    .tabbar .ti.on { color: var(--bl-navy); font-weight: 600; }
    .tabbar .ti.on::after { content: ''; position: absolute; bottom: -8px; width: 4px; height: 4px; border-radius: 999px; background: var(--bl-green); }
    .tabbar.dark { background: rgba(15,15,15,.85); border-top-color: rgba(255,255,255,.08); }
    .tabbar.dark .ti { color: #999999; }
    .tabbar.dark .ti.on { color: #fff; }

    /* check-in */
    .qr-scr { background: radial-gradient(120% 70% at 50% 0%, #3A1412, transparent 60%), #0F0F0F; color: #fff; min-height: 100%; padding: 60px 0 0; position: relative; }
    .qr-scr .top { text-align: center; padding: 10px 24px 0; }
    .qr-scr .top img { width: 150px; }
    .qr-scr h3 { font-size: 21px; margin: 10px 0 2px; font-weight: 600; letter-spacing: -0.02em; }
    .qr-scr .sub { font-size: 12.5px; color: #B8B8B8; }
    .qr-card { margin: 16px 24px 0; background: #fff; color: var(--bl-navy-ink); border-radius: 24px; padding: 22px 20px 18px; text-align: center; }
    .qr-wrap { width: 150px; height: 150px; margin: 0 auto; position: relative; }
    .qr-ring { position: absolute; inset: -10px; border: 2px solid var(--bl-green); border-radius: 18px; animation: qpulse 2s ease-out infinite; }
    @keyframes qpulse { from { transform: scale(.94); opacity: .9; } to { transform: scale(1.06); opacity: 0; } }
    .qr-center { position: absolute; left: 50%; top: 50%; width: 64px; height: 30px; transform: translate(-50%,-50%); background: #fff; border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 3px #fff; }
    .qr-center img { width: 60px; }
    .qr-card .nm { font-weight: 600; font-size: 15px; margin-top: 14px; }
    .qr-card .meta { font-size: 11.5px; color: var(--bl-ink-3); margin-top: 2px; font-family: var(--font-mono); }
    .refresh { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 11px; color: var(--bl-green-ink); font-weight: 600; }
    .nfc { margin: 14px 24px 0; padding-right: 10px !important; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 16px; padding: 13px 14px; display: flex; align-items: center; gap: 12px; }
    .nfc .ic { width: 40px; height: 40px; border-radius: 11px; background: rgba(224,71,61,.18); color: var(--bl-green-bright); display: flex; align-items: center; justify-content: center; }
    .nfc .t { font-size: 13.5px; font-weight: 600; }
    .nfc .m { font-size: 11.5px; color: #B8B8B8; }

    /* classes */
    .days { display: flex; gap: 7px; padding: 0 20px 14px; }
    .day { flex: 1; padding: 10px 0; border-radius: 13px; background: #fff; border: 1px solid var(--bl-line); display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .day .d { font-size: 9.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--bl-ink-3); }
    .day .n { font-size: 16px; font-weight: 600; }
    .day.on { background: var(--bl-navy); border-color: var(--bl-navy); color: #fff; }
    .day.on .d { color: #CCCCCC; }
    .ccard { margin: 0 20px 10px; background: #fff; border-radius: 16px; border: 1px solid var(--bl-line); display: grid; grid-template-columns: 58px 1fr; overflow: hidden; }
    .ccard .tm { background: var(--bl-bg); border-right: 1px solid var(--bl-line); display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .ccard .tm .h { font-family: var(--font-mono); font-size: 16px; font-weight: 600; }
    .ccard .tm .ap { font-size: 9.5px; color: var(--bl-ink-3); text-transform: uppercase; }
    .ccard .bd { padding: 12px 14px; }
    .ccard .tt { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .ccard .m { font-size: 11.5px; color: var(--bl-ink-3); margin-top: 2px; }
    .ccard .cap-row { display: flex; align-items: center; gap: 8px; margin-top: 8px; font-size: 11px; color: var(--bl-ink-3); }
    .bar { width: 84px; height: 4px; border-radius: 999px; background: var(--bl-navy-soft); overflow: hidden; }
    .bar > div { height: 100%; background: var(--bl-green); }
    .ccard.booked { border-color: var(--bl-green); background: #FFF6F5; }
    .ccard.booked .tm { background: var(--bl-green-soft); border-right-color: #EEC6C2; }

    /* account */
    .plan { margin: 0 20px; background: #fff; border-radius: 20px; border: 1px solid var(--bl-line); padding: 18px; }
    .plan .top { display: flex; justify-content: space-between; align-items: flex-start; }
    .plan .pn { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
    .plan .pp { font-family: var(--font-mono); font-size: 13px; color: var(--bl-ink-2); margin-top: 2px; }
    .meter { margin-top: 16px; }
    .meter .row2 { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--bl-ink-3); margin-bottom: 6px; }
    .meter .track { height: 6px; border-radius: 999px; background: var(--bl-navy-soft); overflow: hidden; }
    .meter .track > div { height: 100%; width: 62%; background: linear-gradient(90deg, var(--bl-navy), var(--bl-green)); border-radius: 999px; }
    .acts { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin-top: 16px; }
    .act { height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 7px; font-size: 13px; font-weight: 600; }
    .act.pri { background: var(--bl-navy); color: #fff; }
    .act.yel { background: var(--bl-yellow); color: #111111; }
    .act.sec2 { background: var(--bl-bg); color: var(--bl-navy); border: 1px solid var(--bl-line); }

    /* brand kit */
    .kit { display: grid; grid-template-columns: 1.1fr 1fr 1fr; gap: 20px; }
    .kcard { background: #fff; border: 1px solid var(--bl-line); border-radius: 20px; padding: 24px; }
    .kcard h3 { margin: 0 0 4px; font-size: 15px; font-weight: 600; color: var(--bl-navy-ink); }
    .kcard p { margin: 0 0 18px; font-size: 13px; color: var(--bl-ink-3); line-height: 1.5; }
    .icons { display: flex; gap: 18px; align-items: flex-end; }
    .icon-tile { border-radius: 22%; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(17,17,17,.18); position: relative; overflow: hidden; }
    .icon-tile.navy { background: linear-gradient(150deg, #3A1412, #0F0F0F); }
    .icon-tile.white { background: #fff; border: 1px solid var(--bl-line); box-shadow: 0 8px 20px rgba(17,17,17,.08); }
    .icon-tile img { height: 72%; width: auto; }
    .icon-lbl { font-family: var(--font-mono); font-size: 10px; color: var(--bl-ink-3); text-align: center; margin-top: 8px; letter-spacing: .06em; }
    .sw { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .swatch { border-radius: 12px; overflow: hidden; border: 1px solid var(--bl-line); }
    .swatch .c { height: 54px; }
    .swatch .l { padding: 8px 10px; font-size: 12px; font-weight: 500; color: var(--bl-navy-ink); }
    .swatch .l span { display: block; font-family: var(--font-mono); font-size: 10.5px; color: var(--bl-ink-3); font-weight: 400; }
    .same { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
    .same li { display: flex; gap: 10px; font-size: 13.5px; color: var(--bl-ink-2); line-height: 1.45; }
    .same li svg { flex: 0 0 auto; margin-top: 2px; color: var(--bl-green); }
    .same b { color: var(--bl-navy-ink); font-weight: 600; }

    @media (prefers-reduced-motion: reduce) {
      .splash *, .splash *::before { animation-duration: .01s !important; animation-delay: 0s !important; animation-iteration-count: 1 !important; }
    }
  
</style>
