/* MembershipPal Design Tokens */
:root {
  /* Surfaces — warm-neutral undertone */
  --bg: oklch(0.985 0.003 90);
  --bg-subtle: oklch(0.965 0.004 90);
  --bg-muted: oklch(0.945 0.005 90);
  --surface: #ffffff;
  --surface-elevated: #ffffff;

  /* Ink */
  --ink-1: oklch(0.20 0.01 90);     /* primary text */
  --ink-2: oklch(0.42 0.01 90);     /* secondary text */
  --ink-3: oklch(0.58 0.008 90);    /* tertiary / labels */
  --ink-4: oklch(0.74 0.006 90);    /* placeholder / disabled */

  /* Borders */
  --border: oklch(0.92 0.005 90);
  --border-strong: oklch(0.86 0.006 90);
  --border-faint: oklch(0.95 0.004 90);

  /* Brand accent — electric lime (athletic + clean) */
  --accent: oklch(0.86 0.18 130);
  --accent-ink: oklch(0.32 0.10 130);   /* deep version for text on light */
  --accent-soft: oklch(0.95 0.06 130);  /* tinted background */
  --accent-deep: oklch(0.55 0.14 130);  /* hover/pressed */
  --on-accent: oklch(0.20 0.05 130);    /* text on accent fills */

  /* Status — harmonized chroma */
  --success: oklch(0.62 0.13 150);
  --success-soft: oklch(0.95 0.04 150);
  --warning: oklch(0.74 0.13 75);
  --warning-soft: oklch(0.96 0.05 75);
  --danger: oklch(0.58 0.18 25);
  --danger-soft: oklch(0.96 0.04 25);
  --info: oklch(0.62 0.13 240);
  --info-soft: oklch(0.96 0.03 240);

  /* Typography */
  --font-sans: 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  --font-display: 'Geist', ui-sans-serif, system-ui, -apple-system, sans-serif;

  /* Type scale */
  --t-display: 56px;
  --t-h1: 32px;
  --t-h2: 24px;
  --t-h3: 18px;
  --t-body: 14px;
  --t-small: 13px;
  --t-micro: 11px;

  /* Spacing — 4pt grid */
  --s-1: 4px;
  --s-2: 8px;
  --s-3: 12px;
  --s-4: 16px;
  --s-5: 20px;
  --s-6: 24px;
  --s-8: 32px;
  --s-10: 40px;
  --s-12: 48px;
  --s-16: 64px;

  /* Radii */
  --r-xs: 4px;
  --r-sm: 6px;
  --r-md: 10px;
  --r-lg: 14px;
  --r-xl: 20px;
  --r-pill: 999px;

  /* Shadow */
  --shadow-sm: 0 1px 2px oklch(0.20 0.01 90 / 0.04);
  --shadow-md: 0 4px 16px oklch(0.20 0.01 90 / 0.06), 0 1px 2px oklch(0.20 0.01 90 / 0.04);
  --shadow-lg: 0 12px 40px oklch(0.20 0.01 90 / 0.08), 0 2px 8px oklch(0.20 0.01 90 / 0.05);

  /* Layout */
  --sidebar-w: 240px;
  --topbar-h: 56px;
}

* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--ink-1);
  font-family: var(--font-sans);
  font-size: var(--t-body);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: 'ss01', 'cv11';
}

/* Resets */
button { font: inherit; cursor: pointer; border: 0; background: transparent; color: inherit; }
input, textarea, select { font: inherit; color: inherit; }
a { color: inherit; text-decoration: none; }

/* Numerals tabular by default for numbers */
.tnum, .mono { font-variant-numeric: tabular-nums; }
.mono { font-family: var(--font-mono); }

/* Scrollbar */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; border: 2px solid var(--bg); }
::-webkit-scrollbar-thumb:hover { background: var(--border-strong); }

/* Shared component CSS for MembershipPal */

/* ===== Logo ===== */
.mp-logo {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-display);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink-1);
  font-size: 16px;
}
.mp-logo .mark {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  background: var(--ink-1);
  position: relative;
  display: inline-block;
  flex: 0 0 22px;
}
.mp-logo .mark::before,
.mp-logo .mark::after {
  content: '';
  position: absolute;
  background: var(--accent);
  border-radius: 1px;
}
.mp-logo .mark::before {
  left: 5px; top: 5px;
  width: 4px; height: 12px;
}
.mp-logo .mark::after {
  left: 13px; top: 5px;
  width: 4px; height: 12px;
}

/* ===== Buttons ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 36px;
  padding: 0 14px;
  border-radius: var(--r-md);
  font-size: var(--t-body);
  font-weight: 500;
  border: 1px solid transparent;
  transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
  white-space: nowrap;
  user-select: none;
}
.btn-primary {
  background: var(--accent);
  color: var(--on-accent);
  border-color: oklch(0.78 0.18 130);
}
.btn-primary:hover { background: oklch(0.82 0.19 130); }
.btn-secondary {
  background: var(--surface);
  color: var(--ink-1);
  border-color: var(--border);
}
.btn-secondary:hover { background: var(--bg-subtle); border-color: var(--border-strong); }
.btn-ghost {
  background: transparent;
  color: var(--ink-2);
}
.btn-ghost:hover { background: var(--bg-muted); color: var(--ink-1); }
.btn-dark {
  background: var(--ink-1);
  color: var(--bg);
}
.btn-dark:hover { background: oklch(0.28 0.01 90); }
.btn-sm { height: 28px; padding: 0 10px; font-size: var(--t-small); border-radius: var(--r-sm); }
.btn-lg { height: 44px; padding: 0 18px; font-size: 15px; }
.btn-icon { padding: 0; width: 36px; }
.btn-icon.btn-sm { width: 28px; }

/* ===== Input ===== */
.input {
  height: 36px;
  padding: 0 12px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  background: var(--surface);
  font-size: var(--t-body);
  color: var(--ink-1);
  width: 100%;
  outline: none;
  transition: border-color 120ms ease, box-shadow 120ms ease;
}
.input::placeholder { color: var(--ink-4); }
.input:focus {
  border-color: var(--ink-1);
  box-shadow: 0 0 0 3px oklch(0.20 0.01 90 / 0.06);
}
.label {
  font-size: var(--t-small);
  color: var(--ink-2);
  font-weight: 500;
  display: block;
  margin-bottom: 6px;
}

/* ===== Card ===== */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--s-6);
}
.card-flat {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
}

/* ===== Badge ===== */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 22px;
  padding: 0 8px;
  border-radius: var(--r-pill);
  font-size: var(--t-micro);
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  background: var(--bg-muted);
  color: var(--ink-2);
}
.badge-success { background: var(--success-soft); color: oklch(0.36 0.10 150); }
.badge-warning { background: var(--warning-soft); color: oklch(0.42 0.10 75); }
.badge-danger  { background: var(--danger-soft);  color: oklch(0.40 0.14 25); }
.badge-info    { background: var(--info-soft);    color: oklch(0.40 0.13 240); }
.badge-accent  { background: var(--accent-soft);  color: var(--accent-ink); }
.badge-dark    { background: var(--ink-1); color: var(--bg); }

.badge .dot {
  width: 6px; height: 6px; border-radius: 999px;
  background: currentColor;
}

/* ===== Table ===== */
.tbl {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--t-body);
}
.tbl th {
  text-align: left;
  font-weight: 500;
  font-size: var(--t-small);
  color: var(--ink-3);
  padding: 10px 14px;
  background: var(--bg-subtle);
  border-bottom: 1px solid var(--border);
  letter-spacing: 0.01em;
}
.tbl td {
  padding: 14px;
  border-bottom: 1px solid var(--border-faint);
  color: var(--ink-1);
  vertical-align: middle;
}
.tbl tr:last-child td { border-bottom: 0; }
.tbl tr:hover td { background: var(--bg-subtle); }

/* ===== Avatar ===== */
.avatar {
  width: 32px; height: 32px;
  border-radius: 999px;
  background: var(--bg-muted);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: -0.01em;
  flex: 0 0 auto;
  overflow: hidden;
}
.avatar-lg { width: 48px; height: 48px; font-size: 16px; }
.avatar-sm { width: 24px; height: 24px; font-size: 10px; }

/* ===== Sidebar (admin) ===== */
.app {
  display: grid;
  grid-template-columns: var(--sidebar-w) 1fr;
  min-height: 100vh;
}
.sidebar {
  border-right: 1px solid var(--border);
  background: var(--bg-subtle);
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  position: sticky;
  top: 0;
  height: 100vh;
}
.sidebar .brand { padding: 6px 8px 18px; }
.sidebar .nav-section {
  font-size: var(--t-micro);
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 16px 10px 6px;
  font-weight: 500;
}
.sidebar .nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border-radius: var(--r-sm);
  color: var(--ink-2);
  font-size: var(--t-body);
  cursor: pointer;
  transition: background 100ms ease, color 100ms ease;
}
.sidebar .nav-item:hover { background: var(--bg-muted); color: var(--ink-1); }
.sidebar .nav-item.active {
  background: var(--ink-1);
  color: var(--bg);
}
.sidebar .nav-item .ico { width: 16px; height: 16px; flex: 0 0 16px; }
.sidebar .branch-pill {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px;
  border-radius: var(--r-md);
  border: 1px solid var(--border);
  background: var(--surface);
  font-size: var(--t-small);
  cursor: pointer;
}
.sidebar .branch-pill .branch-dot {
  width: 8px; height: 8px; border-radius: 999px;
  background: var(--accent);
}

/* ===== Topbar ===== */
.topbar {
  height: var(--topbar-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  border-bottom: 1px solid var(--border);
  background: var(--bg);
  position: sticky;
  top: 0;
  z-index: 5;
  gap: 16px;
}
.topbar .crumbs { display: flex; align-items: center; gap: 8px; color: var(--ink-3); font-size: var(--t-small); }
.topbar .crumbs .now { color: var(--ink-1); font-weight: 500; }
.topbar .search {
  position: relative;
  width: 320px;
}
.topbar .search .input { padding-left: 32px; height: 32px; background: var(--bg-subtle); border-color: transparent; }
.topbar .search svg { position: absolute; left: 10px; top: 8px; }

/* ===== Page ===== */
.page {
  padding: 28px 32px 60px;
  max-width: 1480px;
}
.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24px;
  gap: 16px;
}
.page-title { font-size: var(--t-h1); font-weight: 600; letter-spacing: -0.025em; margin: 0; }
.page-sub { color: var(--ink-2); font-size: var(--t-body); margin-top: 4px; }

/* ===== Stat ===== */
.stat {
  padding: 18px 20px;
  border-radius: var(--r-lg);
  border: 1px solid var(--border);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.stat .label { font-size: var(--t-small); color: var(--ink-3); font-weight: 500; }
.stat .value {
  font-size: 30px;
  font-weight: 600;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  color: var(--ink-1);
  font-family: var(--font-display);
}
.stat .delta {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: var(--t-small);
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}
.stat .delta.up { color: oklch(0.42 0.13 150); }
.stat .delta.down { color: oklch(0.50 0.15 25); }

/* ===== Tabs ===== */
.tabs {
  display: inline-flex;
  border-bottom: 1px solid var(--border);
  gap: 24px;
}
.tab {
  padding: 10px 0;
  color: var(--ink-3);
  font-size: var(--t-body);
  font-weight: 500;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  cursor: pointer;
}
.tab.active { color: var(--ink-1); border-bottom-color: var(--ink-1); }
.tab .count { color: var(--ink-4); margin-left: 6px; font-variant-numeric: tabular-nums; }

/* Segmented */
.seg {
  display: inline-flex;
  background: var(--bg-muted);
  padding: 3px;
  border-radius: var(--r-md);
  gap: 2px;
}
.seg button {
  height: 26px;
  padding: 0 12px;
  font-size: var(--t-small);
  color: var(--ink-3);
  border-radius: var(--r-sm);
  font-weight: 500;
}
.seg button.active {
  background: var(--surface);
  color: var(--ink-1);
  box-shadow: var(--shadow-sm);
}

/* utility */
.row { display: flex; align-items: center; gap: 8px; }
.col { display: flex; flex-direction: column; }
.spacer { flex: 1; }
.divider { height: 1px; background: var(--border); width: 100%; }
.muted { color: var(--ink-3); }
.small { font-size: var(--t-small); }
.micro { font-size: var(--t-micro); }

/* ===== Modal ===== */
.modal-backdrop {
  position: fixed; inset: 0;
  background: oklch(0.20 0.01 90 / 0.4);
  backdrop-filter: blur(4px);
  display: flex; align-items: flex-start; justify-content: center;
  padding: 80px 24px;
  z-index: 100;
}
.modal {
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 560px;
  overflow: hidden;
  border: 1px solid var(--border);
}
.modal-head {
  padding: 20px 24px;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
}
.modal-head h3 { margin: 0; font-size: 18px; letter-spacing: -0.015em; font-weight: 600; }
.modal-head .sub { font-size: 12px; color: var(--ink-3); margin-top: 2px; }
.modal-body { padding: 20px 24px; }
.modal-foot {
  padding: 16px 24px;
  border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
  background: var(--bg-subtle);
}
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.help { font-size: 11px; color: var(--ink-3); }

/* ===== Stepper ===== */
.stepper { display: flex; gap: 0; align-items: center; padding: 16px 24px; border-bottom: 1px solid var(--border); background: var(--bg-subtle); }
.stepper .step { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ink-3); }
.stepper .step .n {
  width: 22px; height: 22px; border-radius: 999px;
  background: var(--bg-muted); color: var(--ink-2);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 11px; font-weight: 600;
}
.stepper .step.active { color: var(--ink-1); }
.stepper .step.active .n { background: var(--ink-1); color: var(--bg); }
.stepper .step.done .n { background: var(--accent); color: var(--on-accent); }
.stepper .bar { flex: 1; height: 1px; background: var(--border); margin: 0 12px; min-width: 24px; }


